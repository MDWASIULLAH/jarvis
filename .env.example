# Frontend public values
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Backend service values
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-domain.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional OpenAI-compatible model provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen2.5-coder

# Queue and workers
REDIS_URL=redis://localhost:6379/0
WORKER_TOKEN=replace-with-random-secret
BROWSER_WORKER_CONCURRENCY=2
PLAYWRIGHT_HEADLESS=true
